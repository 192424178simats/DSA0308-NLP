def plural_fsm(word):
    state = 0
    if word.endswith(("s", "sh", "ch", "x", "z", "o")):
        state = 1
    elif word.endswith("y") and len(word) > 1 and word[-2] not in "aeiou":
        state = 2
    else:
        state = 3
    if state == 2:
        plural = word[:-1] + "ies"
    elif state == 1:
        plural = word + "es"
    else:
        plural = word + "s"
    return plural
print("FINITE STATE MACHINE - PLURAL FORM GENERATION")
n = int(input("Enter number of nouns: "))
for i in range(n):
    word = input("Enter a singular noun: ").lower()
    print("Plural form:", plural_fsm(word))
