import re
patterns=[(r'.*ing$','VBG'),(r'.*ed$','VBD'),(r'.*ly$','RB'),(r'.*ous$','JJ'),(r'.*ful$','JJ'),(r'.*ness$','NN'),(r'.*ment$','NN'),(r'.*s$','NNS'),(r'.*','NN')]
def pos_tag(word):
    for pattern,tag in patterns:
        if re.fullmatch(pattern,word.lower()):
            return tag
text=input("Enter a sentence: ")
words=text.split()
print("\nRULE-BASED POS TAGGING")
print("------------------------------")
print("Word\t\tPOS Tag")
print("------------------------------")
for word in words:
    print(word,"\t\t",pos_tag(word))
print("------------------------------")
print("POS Tagging completed successfully!")
